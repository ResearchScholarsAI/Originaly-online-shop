# Copy to .env locally; .env files are excluded from Git. Replace every placeholder.
NODE_ENV=production

# Durable PostgreSQL for production. Do not use the in-memory PGlite preview for real orders.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Public HTTPS origin used in product-export image links and canonical URLs.
PUBLIC_SITE_URL=https://your-real-store-domain.example

# Enable only after the host has injected its dedicated production auth credentials.
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=https://your-real-store-domain.example
GROK_AUTH_ISSUER=https://your-production-auth-issuer.example
GROK_AUTH_CLIENT_ID=replace-with-production-client-id
GROK_AUTH_CLIENT_SECRET=replace-with-production-server-secret

# The exact owner email (from a provider that verifies email ownership) allowed to claim first admin, once.
# Replace before launch; an empty/mismatched allowlist blocks bootstrap.
HQ_ADMIN_EMAILS=owner@example.com

# OTP is intentionally disabled until an SMS provider is configured and tested.
# Supported values: log (default/test only), kavenegar, bird.
SMS_PROVIDER=log
KAVENEGAR_API_KEY=
BIRD_API_KEY=
BIRD_ORIGINATOR=Originaly

# Leave blank until the owner configures and confirms the exact offline payment instructions.
# Orders remain blocked while this is empty; do not place card numbers in Git.
OFFLINE_PAYMENT_INSTRUCTIONS=

# Never expose secret variables with a VITE_ prefix.
